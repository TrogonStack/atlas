{
  "name": "trogon-atlas-jev-benchmark",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "benchmark": "node --experimental-transform-types src/benchmark.ts",
    "test": "node --experimental-transform-types --test src/benchmark.test.ts",
    "test:coverage": "node --experimental-transform-types --test --experimental-test-coverage src/benchmark.test.ts",
    "lint": "oxlint -c ../../.oxlintrc.json . && oxfmt -c ../../.oxfmtrc.json --check .",
    "format": "oxfmt -c ../../.oxfmtrc.json --write . && oxlint -c ../../.oxlintrc.json --fix .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  }
}
