{
  "name": "trogon-atlas-studio",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server/index.mjs\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "serve": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.server.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@grpc/grpc-js": "1.14.5",
    "@grpc/proto-loader": "0.7.15",
    "@tanstack/react-hotkeys": "0.10.0",
    "@xyflow/react": "12.11.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "5.2.1",
    "lucide-react": "0.475.0",
    "nats.ws": "1.30.3",
    "nuqs": "2.9.0",
    "protobufjs": "7.6.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "4.2.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/express": "4.17.25",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.6",
    "jsdom": "29.1.1",
    "supertest": "7.2.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
