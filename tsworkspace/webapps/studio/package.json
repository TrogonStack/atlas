{
  "name": "trogon-atlas-studio",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server/index.mjs\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "serve": "vite preview",
    "lint": "oxlint -c ../../.oxlintrc.json . && oxfmt -c ../../.oxfmtrc.json --check .",
    "format": "oxfmt -c ../../.oxfmtrc.json --write . && oxlint -c ../../.oxlintrc.json --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.server.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@grpc/grpc-js": "1.14.5",
    "@grpc/proto-loader": "0.8.1",
    "@tanstack/react-hotkeys": "0.13.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "lucide-react": "1.52.0",
    "nats.ws": "1.30.3",
    "nuqs": "2.10.1",
    "protobufjs": "8.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "10.0.6",
    "jsdom": "29.1.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
