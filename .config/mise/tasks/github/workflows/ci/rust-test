#!/usr/bin/env bash
#MISE description="Run cargo nextest and doctests across the Rust workspace (reads TROGON_ATLAS_TEST_NATS_URL and TROGON_ATLAS_EXTRA_FIXTURE_DIRS from the environment)"
set -euo pipefail

cd "$MISE_PROJECT_ROOT/rsworkspace"
cargo nextest run --workspace --profile ci
cargo test --doc --workspace
