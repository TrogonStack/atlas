#!/usr/bin/env bash
#MISE description="Package the named chart under devops/helm/charts and push it unless the OCI registry already has its version"
set -euo pipefail

: "${CHARTS_REGISTRY:?set CHARTS_REGISTRY, e.g. oci://ghcr.io/trogonstack/atlas/charts}"
name="${1:?usage: push <chart>}"

chart="$MISE_PROJECT_ROOT/devops/helm/charts/$name"
version="$(helm show chart "$chart" | awk '/^version:/ { print $2 }')"

if lookup="$(helm show chart "$CHARTS_REGISTRY/$name" --version "$version" 2>&1 >/dev/null)"; then
  echo "skipping $name $version (already published)" >&2
  exit 0
fi
# GHCR answers "denied" for a package that does not exist yet; any other
# failure could hide a published version, and pushing would overwrite it.
if ! grep -qE ': not found$|: denied: ' <<<"$lookup"; then
  echo "$lookup" >&2
  exit 1
fi

if grep -q '^dependencies:' "$chart/Chart.yaml"; then
  helm dependency build "$chart" >/dev/null
fi

packages_dir="$(mktemp -d)"
trap 'rm -rf "$packages_dir"' EXIT

echo "publishing $name $version" >&2
helm package "$chart" --destination "$packages_dir" >/dev/null
helm push "$packages_dir/$name-$version.tgz" "$CHARTS_REGISTRY"
