#!/usr/bin/env bash
#MISE description="Regenerate the trogon-atlas-semconv crate from otel/registry with OpenTelemetry Weaver"
set -euo pipefail

cd "$MISE_PROJECT_ROOT"

OUT="rsworkspace/crates/trogon-atlas-semconv/src/semconv"
TEMPLATE_PACKAGE="https://github.com/TrogonStack/trogonstack-weaver-packages.git@v0.1.1[templates]"

rm -rf "$OUT"
mkdir -p "$OUT"

weaver registry generate \
  --v2 \
  --registry otel/registry \
  --params .config/weaver/params.yaml \
  -t "$TEMPLATE_PACKAGE" \
  code/rust \
  "$OUT"

cargo fmt --manifest-path rsworkspace/Cargo.toml -p trogon-atlas-semconv
