# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.

# Anthropic API key used by the LLM analysis feature.
ANTHROPIC_API_KEY=

# Shared secret for authenticating gRPC clients against trogon-atlas-server.
# Leave empty to disable token auth during local development.
EVENTMODEL_AUTH_TOKEN=

# LLM provider to use for event model analysis.
# Accepted values: anthropic, disabled (any other value hard-fails startup).
EVENTMODEL_LLM=anthropic

# Model identifier passed to the LLM provider (e.g. claude-sonnet-4-6, claude-opus-4-8).
# Only used when EVENTMODEL_LLM=anthropic.
EVENTMODEL_LLM_MODEL=claude-sonnet-4-6
