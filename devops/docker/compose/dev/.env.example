# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.

# Shared secret for the nats service and trogon-atlas-server's connection
# to it. Override both together; they must match.
# TROGON_ATLAS_NATS_PASSWORD=localdevpass

# Enables Jev field-source evaluation before the generative analyzer.
# TROGON_ATLAS_JEV=false

# Gateway API key for Jev.
# AI_GATEWAY_API_KEY=

# Timeout, in seconds, for Jev gateway requests.
# TROGON_ATLAS_JEV_TIMEOUT_SECS=8

# Minimum selected-option probability Jev accepts.
# TROGON_ATLAS_JEV_MIN_PROBABILITY=0.95

# Leave unset: a set-but-empty value is read by clap as present, which
# sends trogon-atlas-server down the legacy-token auth path instead of the
# anonymous path this stack is built around. Set a real token only when
# you also set TROGON_ATLAS_INSECURE_ALLOW_ANONYMOUS=false.
# TROGON_ATLAS_AUTH_TOKEN=

# Lets anonymous callers reach trogon-atlas-server with no token. Set to
# false and provide TROGON_ATLAS_AUTH_TOKEN outside trusted local networks.
# TROGON_ATLAS_INSECURE_ALLOW_ANONYMOUS=true

# Preshared key shared between SpiceDB and trogon-atlas-server.
# TROGON_ATLAS_SPICEDB_PRESHARED_KEY=localdevkey
